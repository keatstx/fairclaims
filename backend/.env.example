# FairClaims Concierge — environment template
# Copy to backend/.env (gitignored) for local dev. Render sets these
# via the dashboard / render.yaml in production.

# LLM backend choice. `mock` = canned responses (no network). `api` =
# Groq via OpenAI-compatible endpoint (default in production).
FAIRCLAIMS_LLM_BACKEND=mock

# Groq API config — default base + 70B model. Override only if changing
# providers. FAIRCLAIMS_LLM_API_KEY is REQUIRED when FAIRCLAIMS_LLM_BACKEND=api.
FAIRCLAIMS_LLM_API_BASE=https://api.groq.com/openai/v1
FAIRCLAIMS_LLM_MODEL=llama-3.3-70b-versatile
FAIRCLAIMS_LLM_API_KEY=

# SQLite path. Local dev = repo-relative; Render = /data/fairclaims.db.
FAIRCLAIMS_DB_PATH=./data/fairclaims.db

# Bearer token gating /admin/questions/* endpoints. Empty = block all
# admin traffic (NOT auto-disable). Generate a 32-byte random hex.
FAIRCLAIMS_ADMIN_TOKEN=

# Salt for visitor_hash. Render auto-generates with `generateValue`.
# Locally any non-empty string is fine for testing.
FAIRCLAIMS_VISITOR_HASH_SALT=

# Kill switch. Set to false to make /concierge/ask return 503.
FAIRCLAIMS_CONCIERGE_ENABLED=true

# Static-site root. Docker = /app; local dev = repo root (.).
FAIRCLAIMS_STATIC_DIR=.

# Logging — `json` for prod, `console` for local dev readability.
FAIRCLAIMS_LOG_RENDERER=console
